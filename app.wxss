page {
  background: #f5f0e8;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #2b2b2b;

  /* ── 设计令牌（2026-10-01 与 design/design-tokens.md 同源，改值必须两边同步）── */
  /* 色板：暖纸底 + 暖橙主色 + 深墨按钮（克制三原则：主色只做锚点，大面积交给纸底与灰阶） */
  --bg-page: #f5f0e8;        /* 页面底 */
  --bg-card: #fffdf8;        /* 卡片/输入框底 */
  --bg-soft: #fdf9f0;        /* 浅底块（帮助/灵感条） */
  /* ── 表面级（2026-10-06 /normalize 新增）──
     背景色失控的根因：58 种浅暖底挤在明度 224~255 的 31 格区间里，
     全是「想要个浅底就随手调一个」的结果，肉眼根本分辨不出差别。
     按 CIE76 ΔE 聚类（阈值 3.0，肉眼无差别）收敛为下列5 档。
     每档注释里的 ΔE 是「簇内最大偏差」，全部 < 3.0，即替换后视觉零差异。
     ⚠️ 以后背景色只能用这 5 档 + 上面 3 个基础档，不得再手调。
        新增浅底前先用 tools_local/tok_cluster.py 复核是否真的需要新档。 */
  --bg-surface-1: #f7f1e6;   /* 最常用浅底·芯片/次级块（15 色合一，ΔE 2.99） */
  --bg-surface-2: #f0e2c8;   /* 浅暖底·选中/强调块  （5 色合一，ΔE 2.79） */
  --bg-surface-3: #fff3e0;   /* 浅奶底·提示条        （7 色合一，ΔE 2.82） */
  --bg-surface-4: #ece4d6;   /* 灰暖底·分隔/禁用    （4 色合一，ΔE 2.50） */
  --bg-surface-5: #e5d9c4;   /* 深一档暖底·边框陪衬（5 色合一，ΔE 1.87） */
  --border: #e0d6c2;         /* 常规描边 */
  --border-soft: #e7ddca;    /* 浅描边（帮助块） */
  --ink: #2b2b2b;            /* 主文本 & 深墨按钮底（本设计深墨按钮=墨色） */
  --text-title: #4a3b28;     /* 标题暖墨 */
  --text-body: #5b5346;      /* 正文按钮字 */
  --text-sub: #8a8378;       /* 次要文字 */
  --text-tertiary: #9a8f7c;  /* 提示/占位 */
  --primary: #f5793b;        /* 暖橙主色（锚点强调） */
  --primary-deep: #e65100;   /* 主色深（积分/付费） */
  --accent-blue: #378ADD;    /* 点睛蓝（分镜） */
  --accent-green: #4caf7d;   /* 点睛绿（海报） */
  --success: #2e7d32;        /* 成功 */
  --danger: #c0504d;         /* 错误/删除 */
  /* 字号（rpx） */
  --fs-display: 52rpx;  /* 首页品牌 */
  --fs-h1: 38rpx;       /* 页标题 */
  --fs-title: 32rpx;    /* 卡片标题 */
  --fs-body: 28rpx;     /* 正文/按钮 */
  --fs-label: 25rpx;    /* 表单标签 */
  --fs-sub: 24rpx;      /* 副文案 */
  --fs-hint: 22rpx;     /* 提示/脚注 */
  /* 间距（4px 网格的 rpx 倍数） */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 48rpx;
  /* 圆角 */
  --r-sm: 12rpx;   /* 输入框/灵感条 */
  --r-md: 16rpx;   /* 卡片/画布 */
  --r-lg: 20rpx;   /* 工具卡/积分条 */
  --r-xl: 24rpx;   /* 品牌 hero */
  --r-pill: 999rpx;/* 胶囊 */
  /* 阴影 */
  --shadow-card: 0 4rpx 14rpx rgba(150, 110, 50, 0.08);
  --shadow-float: 0 8rpx 24rpx rgba(150, 110, 50, 0.12);
}

/* ⚠️ WXSS 编译器选择器白名单只有 .class / #id / element / element,element / ::after / ::before。
   不要在这里写 @media / * 通用选择器 / :not() —— 会直接报「编译 .wxss 文件错误」。
   （曾因 prefers-reduced-motion 兜底块用了 *:not(...) 整个编译挂掉，2026-09-22 移除）
   装饰性动效影响极小，无需无障碍兜底；如确需降低动效，请在具体页面用类选择器逐条关。 */

/* ── 保存按钮翻转反馈（流体交互库 #27 · A 档 · 2026-10-01 全局化）──
   铁律 5：连续触发用双套等价 keyframes 奇偶交替（saved-a / saved-b），防重放失效；
   铁律 6：copiedKey 式状态驱动 + setTimeout 1.6s 复原（timer 引用存页面防竞态）；
   内联反馈替代 toast。transform 用 deg（无 rpx 参与兼容稳）。 */
@keyframes saveFlipA {
  0% { transform: rotateX(0deg); }
  50% { transform: rotateX(90deg); }
  100% { transform: rotateX(0deg); }
}
@keyframes saveFlipB {
  0% { transform: rotateX(0deg); }
  50% { transform: rotateX(90deg); }
  100% { transform: rotateX(0deg); }
}
.btn.save-btn { backface-visibility: hidden; }
.btn.save-btn.saved-a { animation: saveFlipA 0.5s ease; background: #2e7d32; color: #fff; }
.btn.save-btn.saved-b { animation: saveFlipB 0.5s ease; background: #2e7d32; color: #fff; }

/* ── 首页工具卡长按拖拽排序（流体交互库 #6 · B 档 · 2026-10-01）──
   铁律 2：被拖行走 inline transition:none，其余行走 CSS transition 平滑让位；
   铁律 3：让位量用 boundingClientRect 实测（onToolDragStart 内量好 rects），
           不按均匀行高估算。 */
.tool-card {
  transition: transform 0.22s ease, box-shadow 0.22s ease;
}
.tool-card.dragging {
  transition: none;
  box-shadow: 0 12rpx 32rpx rgba(150, 110, 50, 0.28);
  opacity: 0.92;
  z-index: 5;
}
.tool-hint-drag { font-size: 22rpx; color: #b3a890; text-align: center; margin-top: 4rpx; }

/* ── 卡片「排版风格 + 背景图」控件（2026-10-06 全局化）──
   天气 / 节气 / 金句 / 台词书摘四页共用同一块 UI 与同一套状态
   （utils/card_style_mixin.js）。放全局而非各自 wxss：四页 wxss 复制
   必然漂移，且这组控件的属性名互不通用，不会误伤别的页面。 */
.style-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.style-chip {
  padding: 12rpx 28rpx; border-radius: 999rpx;
  background: #f7f1e6; border: 1rpx solid var(--border);
  font-size: 25rpx; color: var(--primary-deep);
}
.style-chip.on { background: var(--primary); border-color: var(--primary); color: #fff; }

.bg-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 14rpx; }
.bg-mode { flex: 1; font-size: 23rpx; color: var(--primary-deep); }
.bg-ops { display: flex; gap: 14rpx; flex: none; }
.bg-op {
  padding: 8rpx 18rpx; border-radius: 999rpx;
  background: #f7f1e6; border: 1rpx solid var(--border);
  font-size: 22rpx; color: var(--primary-deep);
}
.bg-scroll { white-space: nowrap; width: 100%; }
.bg-item {
  display: inline-block; width: 130rpx; height: 176rpx;
  margin-right: 14rpx; border-radius: 12rpx; overflow: hidden;
  border: 3rpx solid transparent; box-sizing: border-box; vertical-align: top;
}
.bg-item.on { border-color: var(--primary); }
.bg-thumb { width: 100%; height: 100%; display: block; }
.bg-credit { margin-top: 12rpx; font-size: 21rpx; color: var(--text-tertiary); line-height: 1.6; }
.bg-picked { margin-top: 12rpx; font-size: 24rpx; color: var(--success); }
.bg-hint { margin-top: 10rpx; font-size: 22rpx; color: var(--text-tertiary); line-height: 1.6; }

/* 分组卡片容器：天气 / 节气 / 金句 / 台词书摘四页的「风格」「背景」等区块共用 */
.block { background: var(--bg-card); border: 1rpx solid var(--border-soft); border-radius: var(--r-md); padding: 22rpx; margin-bottom: 20rpx; }
.block-title { font-size: 26rpx; font-weight: 600; color: var(--text-title); margin-bottom: 16rpx; }

/* ═══════════════════════════════════════════════════════════════════════
   分层选择器（大类 → 小类下钻 + 常用前置）—— 金句/天气/节气/台词四页共用
   ═══════════════════════════════════════════════════════════════════════
   为什么不做成「所有类目一次性铺开」：
     标签随收藏无限增长，平铺会占满整屏且无起点（用户明确反馈观感差）。
   层级：常用（一步到位）→ 大类（单行横滚）→ 小类（只显示当前大类下的）。
   视觉上靠**字号与底色**分层：小标题是弱化的，字才是可选的——避免三层都是胶囊、看不出主次。 */
.picker {
  background: var(--bg-card);
  border: 1rpx solid var(--border-soft);
  border-radius: var(--r-md);
  padding: 20rpx 20rpx 8rpx;
  margin-bottom: 16rpx;
}
.pg-row { margin-bottom: 18rpx; }
.pg-row:last-child { margin-bottom: 10rpx; }
/* 小标题：弱化成灰字+ 小圆点，明确它是「这组标签的标题」而不是一个可点项 */
.pg-cap {
  font-size: 21rpx; color: var(--text-tertiary);
  letter-spacing: 1rpx; margin-bottom: 12rpx;
  display: flex; align-items: center;
}
.pg-cap::before {
  content: ''; width: 6rpx; height: 6rpx; border-radius: 50%;
  background: var(--primary); margin-right: 10rpx; opacity: 0.55;
}
.pg-cap-sub { color: var(--text-body); margin-left: 8rpx; font-weight: 500; }

/* 常用区：主色描边，和下面的大类区拉开视觉差——它是「快捷入口」而非「完整分类」 */
.pg-hot { display: flex; flex-wrap: wrap; gap: 12rpx; }
.pg-hot-chip {
  font-size: 25rpx; color: var(--primary-deep);
  background: var(--bg-surface-1);
  border: 1rpx solid var(--primary);
  border-radius: var(--r-pill); padding: 9rpx 24rpx;
}
.pg-hot-chip.on { background: var(--primary); color: #fff; }

/* 大类区：横向滚动，避免大类变多后换行占高 */
.pg-scroll { white-space: nowrap; width: 100%; }
.pg-chip {
  display: inline-block;
  font-size: 25rpx; color: var(--text-body);
  background: var(--bg-soft);
  border: 1rpx solid var(--border);
  border-radius: var(--r-pill); padding: 9rpx 26rpx;
  margin-right: 12rpx;
}
.pg-chip.on { background: var(--ink); color: #fff; border-color: var(--ink); }
/* 有常用项的大类打个小圆点，暗示「里面有你常用的」，可少点一次 */
.pg-dot {
  display: inline-block; width: 10rpx; height: 10rpx; border-radius: 50%;
  background: var(--primary); margin-right: 8rpx; vertical-align: 1rpx;
}
.pg-chip.on .pg-dot { background: #fff; }

/* 小类区：浅底小胶囊，明显弱于大类（从属关系） */
.pg-items { display: flex; flex-wrap: wrap; gap: 12rpx; }
.pg-item {
  font-size: 23rpx; color: var(--text-body);
  background: var(--bg-surface-1);
  border: 1rpx solid transparent;
  border-radius: var(--r-pill); padding: 8rpx 22rpx;
}
.pg-item.on {
  background: var(--bg-surface-2); color: var(--primary-deep);
  border-color: var(--primary); font-weight: 500;
}
.stat-filter { color: var(--primary-deep); }

/* 分层选择器里的图标项 + 天气页组合回显 */
.pg-ico { margin-right: 6rpx; font-size: 26rpx; }
.pg-item-ico { padding: 10rpx 24rpx; font-size: 25rpx; }
/* 组合回显：让用户不逐个点小类也能确认当前选了什么 */
.combo {
  display: flex; align-items: center; gap: 10rpx;
  background: var(--bg-surface-1);
  border: 1rpx solid var(--border);
  border-radius: var(--r-pill);
  padding: 12rpx 24rpx; margin-bottom: 16rpx;
}
.combo-ico { font-size: 30rpx; }
.combo-txt { font-size: 26rpx; color: var(--text-title); font-weight: 500; }
.combo-sep { color: var(--text-tertiary); }
