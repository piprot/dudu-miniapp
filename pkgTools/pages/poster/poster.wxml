<view class="page">
  <view class="hd">
    <view class="hd-title">🖼️ 海报长图制作</view>
    <view class="hd-sub">写一句话，自动排成一张精美长图 · 高度随内容自适应</view>
  </view>

  <view class="help-toggle" bindtap="onToggleHelp">{{showHelp ? '收起说明' : '怎么用'}}</view>
  <view class="help" wx:if="{{showHelp}}">
    <view class="help-line">① 填标题 / 金句 / 正文（任填其一），金句默认带今日推荐，可点「换一套」</view>
    <view class="help-line">② 想换气质？页面底部「出图设置」可换排版风格（9 种）、背景图（内置 60 张或相册）、衬底强弱与主题配色</view>
    <view class="help-line">③ 点「制作海报」，再「保存到相册」，图片只存在你手机本地，不会上传任何服务器。</view>
    <view class="help-line">本工具仅在本机制作与保存图片，不提供内容发布与传播功能。</view>
  </view>

  <!-- 表单 -->
  <view class="form">
    <view class="field">
      <view class="label">标题（可留空）</view>
      <input class="input" value="{{form.title}}" bindinput="onField" data-field="title" placeholder="如：把日子过成海报" />
    </view>

    <view class="field">
      <view class="label">金句（海报主角）</view>
      <textarea class="ta" value="{{form.quote}}" bindinput="onField" data-field="quote"
        placeholder="写一句打动人的话" maxlength="-1" />
      <button class="btn ghost" bindtap="onShuffleQuote">🎲 换一套文案（库存 {{quotePoolSize}} 条）</button>
      <view class="hint">金句库按天自动换今日推荐，不满意就点上面自己挑</view>
    </view>

    <view class="field">
      <view class="label">正文补充（可留空）</view>
      <textarea class="ta short" value="{{form.body}}" bindinput="onField" data-field="body"
        placeholder="写点什么…（长图不会截断内容）" maxlength="-1" />
    </view>

  </view>

  <button class="btn primary gen" bindtap="onGenPoster">制作海报（{{posterCost}} 积分）</button>
  <view class="err" wx:if="{{err}}">{{err}}</view>

  <view class="canvas-wrap">
    <canvas type="2d" id="posterCanvas" class="canvas" style="height:{{canvasH}}px"></canvas>
    <view wx:if="{{!rendered}}" class="canvas-ph">点「制作海报」后，长图会显示在这里</view>
    <button wx:if="{{rendered}}" class="btn primary save save-btn {{savedKey ? 'saved-' + savedKey : ''}}" bindtap="onSaveImage">{{savedKey ? '✓ 已存相册' : '保存到相册'}}</button>
  </view>

  <!-- 出图设置：2026-10-25 新增，与天气/节气/金句/每日一句/日签共用 components/card-config。
       一次补齐：排版风格（9 种）/ 内置压缩图库（60 张）/ 相册背景 / 衬底强弱 / 主题配色。
       旧版本页只有「主题 chip + 从相册选一张背景图」两个参数，没有其他可选。 -->
  <card-config
    style-list="{{styleList}}" style-groups="{{styleGroups}}" style-key="{{styleKey}}" style-desc="{{styleDesc}}"
    style-hint="风格决定字体族、字号、字距、对齐与装饰符号。全部用系统字体，不下载、不闪烁。"
    builtin-photos="{{builtinPhotos}}" bg-source="{{bgSource}}" bg-photo-id="{{bgPhotoId}}"
    local-bg="{{localBg}}" photo-mode-label="{{photoModeLabel}}" bg-author="{{bgAuthor}}"
    bg-hint="内置 60 张随包压缩，不走网络、不需服务器域名白名单，永远可用。"
    themes="{{themes}}" theme="{{theme}}"
    bind:style="onPickStyle" bind:builtin="onPickBuiltinBg" bind:album="onPickAlbumBg"
    bind:clearphoto="onClearPhoto" bind:shufflephoto="onShufflePhoto"
    bind:cyclemode="onCyclePhotoMode" bind:theme="onPickTheme" />

  <view class="tip">制作内容仅保存在你手机本地；本小程序不提供内容发布与传播功能。</view>
</view>

  <!-- 隐私授权面板：同意按钮必须是 open-type="agreePrivacyAuthorization"，见组件注释 -->
  <privacy-panel privacy-show="{{privacyShow}}" />
