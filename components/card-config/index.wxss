/* components/card-config/index.wxss */
/* 折叠头 */
.cc {
  background: var(--bg-card);
  border: 1rpx solid var(--border-soft);
  border-radius: var(--r-md);
  margin-bottom: 20rpx;
  overflow: hidden;
}
.cc-head {
  display: flex; align-items: center;
  padding: 22rpx;
}
.cc-head-t {
  font-size: 26rpx; font-weight: 500; color: var(--text-title);
  flex: none; margin-right: 14rpx;
}
.cc-head-s {
  font-size: 21rpx; color: var(--text-tertiary);
  flex: 1; line-height: 1.4;
}
/* 箭头：纯 CSS 三角 + 旋转，不依赖图片资源 */
.cc-caret {
  flex: none;
  width: 12rpx; height: 12rpx;
  margin-left: 12rpx;
  border-right: 3rpx solid var(--text-tertiary);
  border-bottom: 3rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  transition: transform 0.2s ease;
}
.cc-caret.up { transform: rotate(-135deg); }

/* 展开体：用 padding 动画而非 max-height —— max-height 过渡需要猜高度，
   会得到「先快后慢」的假动画（流体交互库铁律同源：能量要交出去，不是演出来） */
.cc-body {
  padding: 0 22rpx 22rpx;
  border-top: 1rpx solid var(--border-soft);
}
.cc-sec { padding-top: 20rpx; }
.cc-sec + .cc-sec { margin-top: 4rpx; }
.cc-sec-t {
  font-size: 24rpx; color: var(--text-body);
  font-weight: 500; margin-bottom: 14rpx;
}
.cc-hint {
  font-size: 21rpx; color: var(--text-tertiary);
  line-height: 1.6; margin-top: 12rpx;
}
/* 当前风格的说明行（2026-10-12）：比 cc-hint 更靠上、颜色更实——
   它是「选这个风格会变成什么样」，属于决策信息，不该和背景图的使用说明同一视觉层级。 */
.cc-styledesc {
  font-size: 21rpx; color: var(--text-body);
  line-height: 1.6; margin-top: 14rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--primary);
}
/* 风格分组（2026-10-12）：卡片版式 / 成图版式 · 3:4。
   两组出品形态不同（有没有小程序码、是不是固定竖幅），必须让用户选之前就看清。 */
.style-grp { margin-bottom: 16rpx; }
.style-grp:last-child { margin-bottom: 0; }
.style-grp-t { display: flex; align-items: baseline; margin-bottom: 10rpx; }
.style-grp-n { font-size: 22rpx; color: var(--text-body); font-weight: 500; }
.style-grp-h {
  font-size: 19rpx; color: var(--text-tertiary);
  margin-left: 12rpx; flex: 1;
}
