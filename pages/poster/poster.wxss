.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.hd { margin-bottom: 18rpx; }
.hd-title { font-size: 38rpx; font-weight: 700; color: var(--ink); }
.hd-sub { font-size: 24rpx; color: #8a8378; margin-top: 8rpx; }

.help-toggle {
  display: inline-block; font-size: 23rpx; color: #b3905a; font-weight: 600;
  background: #fdf9f0; border: 2rpx solid #f0e2c8; border-radius: 999rpx; padding: 8rpx 22rpx;
  margin-bottom: 12rpx;
}
.help {
  background: var(--bg-card); border: 1rpx solid var(--border-soft); border-radius: 16rpx;
  padding: 18rpx 22rpx; margin-bottom: 16rpx;
}
.help-line { font-size: 24rpx; color: #6f6555; line-height: 1.7; }

.form { margin-bottom: 16rpx; }
.field { margin-bottom: 16rpx; }
.label { font-size: 25rpx; font-weight: 600; color: #6b5636; margin-bottom: 8rpx; }
.input {
  width: 100%; box-sizing: border-box; background: var(--bg-card);
  border: 1rpx solid var(--border); border-radius: 14rpx; padding: 16rpx 18rpx;
  font-size: 27rpx; color: var(--ink);
}
.ta {
  width: 100%; box-sizing: border-box; min-height: 140rpx; background: var(--bg-card);
  border: 1rpx solid var(--border); border-radius: 14rpx; padding: 16rpx 18rpx;
  font-size: 27rpx; line-height: 1.6; color: var(--ink);
}
.ta.short { min-height: 100rpx; }
.cover-mini { font-size: 22rpx; color: var(--success); margin-top: 8rpx; }

.btn {
  font-size: 28rpx; color: #5b5346; background: #ece4d6;
  border-radius: 14rpx; padding: 18rpx 0; line-height: 1.4; margin: 0;
}
.btn.ghost { flex: none; padding: 14rpx 32rpx; font-size: 26rpx; }
.btn.primary { background: var(--ink); color: var(--bg-card); }
.btn.gen { width: 100%; margin-top: 4rpx; }
.btn.save { flex: none; margin-top: 20rpx; padding: 18rpx 60rpx; }

.err { margin-top: 16rpx; font-size: 24rpx; color: var(--danger); line-height: 1.6; }

.canvas-wrap { margin-top: 24rpx; }
.canvas {
  width: 100%; background: var(--bg-page); border-radius: 16rpx; display: block;
}
.tip { margin-top: 24rpx; font-size: 22rpx; color: #9a8f7c; line-height: 1.6; }

.canvas-ph {
  margin-top: 8rpx; font-size: 24rpx; color: #b3a890;
  text-align: center; padding: 40rpx 0;
}

.hint { margin-top: 8rpx; font-size: 22rpx; color: #9a8b74; line-height: 1.5; }
.field .btn.ghost { margin-top: 10rpx; }

.theme-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 0 4rpx; }
.theme-chip {
  font-size: 24rpx; color: #6b5636; background: #f3ecdf;
  border: 2rpx solid #e5d9c4; border-radius: 24rpx; padding: 8rpx 24rpx;
}
.theme-chip.on { background: var(--ink); color: var(--bg-card); border-color: var(--ink); }
