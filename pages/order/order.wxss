.order-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.header {
  padding: 16rpx 8rpx 20rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8175;
}

.state {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tip {
  font-size: 30rpx;
  color: #4a4a4a;
}
.hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a8175;
  text-align: center;
  padding: 0 40rpx;
}

.retry-btn,
.go-btn {
  margin-top: 32rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 48rpx;
  line-height: 76rpx;
}
.retry-btn::after,
.go-btn::after {
  border: none;
}

.list {
  margin-top: 12rpx;
}
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.row.top {
  margin-bottom: 14rpx;
}
.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
  padding-right: 16rpx;
}
.amount {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
}
.meta {
  margin-bottom: 12rpx;
}
.status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.status-delivered {
  color: #2e8b57;
  background: rgba(46, 139, 87, 0.12);
}
.status-pending {
  color: #c8881f;
  background: rgba(200, 136, 31, 0.12);
}
.status-paid {
  color: #2e8b57;
  background: rgba(46, 139, 87, 0.12);
}
.time {
  font-size: 24rpx;
  color: #8a8175;
}
.no {
  font-size: 22rpx;
  color: #b3aaa0;
  word-break: break-all;
}
