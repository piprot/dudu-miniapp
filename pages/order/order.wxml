<view class="order-page">
  <view class="header">
    <view class="title">我的订单</view>
    <view class="subtitle">虚拟支付订单记录（个人主体）</view>
  </view>

  <view wx:if="{{loading}}" class="state">
    <view class="tip">加载中…</view>
  </view>

  <view wx:elif="{{err}}" class="state">
    <view class="tip">{{err}}</view>
    <button class="retry-btn" bindtap="onRetry">重试</button>
  </view>

  <view wx:elif="{{empty}}" class="state">
    <view class="tip">还没有订单</view>
    <view class="hint">在「解锁 / 充值」完成支付后，订单会显示在这里。</view>
    <button class="go-btn" bindtap="goPay">去充值</button>
  </view>

  <view wx:else class="list">
    <view class="card" wx:for="{{list}}" wx:key="outTradeNo">
      <view class="row top">
        <view class="name">{{item.productName}}</view>
        <view class="amount">{{item.amountText}}</view>
      </view>
      <view class="row meta">
        <view class="status status-{{item.status}}">{{item.statusText}}</view>
        <view class="time">{{item.timeText}}</view>
      </view>
      <view class="row no">订单号：{{item.outTradeNo}}</view>
    </view>
  </view>
</view>
