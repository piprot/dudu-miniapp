<view class="webwrap">
  <view class="bridge">
    <view class="bridge-title">完整作品 / 画面感内容样板间</view>
    <view class="bridge-sub">小程序内为纯工具，作品与定制样板统一放在网页版查看。</view>
    <view class="bridge-url" wx:if="{{configured}}" user-select="true">{{url}}</view>
    <view class="bridge-url empty" wx:else>网页地址未配置（请在 utils/config.js 的 H5.comicUrl 填写）</view>
    <button class="bridge-btn" wx:if="{{configured}}" bindtap="onCopyUrl">📋 复制网页链接</button>
    <view class="bridge-note">复制后在手机浏览器打开即可查看完整内容</view>
  </view>
</view>
