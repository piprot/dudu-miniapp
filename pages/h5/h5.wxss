.webwrap {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 48rpx;
  background: #f5f0e8;
}
.bridge {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(150, 110, 50, 0.08);
}
.bridge-title { font-size: 34rpx; font-weight: 800; color: #4a3b28; margin-bottom: 16rpx; }
.bridge-sub { font-size: 26rpx; color: #8a7554; line-height: 1.7; margin-bottom: 28rpx; }
.bridge-url {
  font-size: 26rpx; color: #2f6fb0; line-height: 1.7;
  background: #f3f7fb; border: 2rpx solid #d7e6f5; border-radius: 14rpx;
  padding: 20rpx; word-break: break-all; margin-bottom: 24rpx;
}
.bridge-url.empty { color: #a89270; background: #f3ece0; border-color: #e6d8c2; }
.bridge-btn {
  background: linear-gradient(135deg, #ffd98a, #ffb84d);
  color: #6b4a0e; font-weight: 700; border-radius: 14rpx; font-size: 28rpx;
  margin-bottom: 16rpx;
}
.bridge-note { font-size: 22rpx; color: #a89270; text-align: center; }
