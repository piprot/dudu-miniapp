<view class="page">
  <view class="hd">
    <view class="hd-title">🗓️ 节气·今日文案</view>
    <view class="hd-sub">节气 / 节日应景文案成卡（纯本地静态库，零 AI）</view>
  </view>

  <view class="today-card">
    <view class="today-badge" wx:if="{{today.name}}">{{today.name}}</view>
    <view class="today-text">{{today.text}}</view>
    <view class="today-acts">
      <button class="btn ghost" bindtap="onGenToday">🖼️ 生成今日卡</button>
      <button wx:if="{{today.type === 'normal'}}" class="btn ghost" bindtap="onShuffleToday">🔄 换一条</button>
      <button class="btn ghost" bindtap="onSaveToVault">💾 存收藏馆</button>
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{tab === 'term' ? 'on' : ''}}" bindtap="switchTab" data-tab="term">二十四节气</view>
    <view class="tab {{tab === 'festival' ? 'on' : ''}}" bindtap="switchTab" data-tab="festival">常用节日</view>
  </view>

  <view class="list">
    <view wx:if="{{tab === 'term'}}" wx:for="{{termList}}" wx:key="name" class="item" bindtap="onPickTerm" data-name="{{item.name}}" data-text="{{item.text}}">
      <view class="item-name">{{item.name}}</view>
      <view class="item-date">{{item.date}}</view>
      <view class="item-text">{{item.text}}</view>
    </view>
    <view wx:if="{{tab === 'festival'}}" wx:for="{{festivalList}}" wx:key="name" class="item" bindtap="onPickFestival" data-name="{{item.name}}" data-text="{{item.text}}">
      <view class="item-name">{{item.name}}</view>
      <view class="item-date">{{item.date}}</view>
      <view class="item-text">{{item.text}}</view>
    </view>
  </view>

  <view class="block">
    <view class="block-title">排版风格</view>
    <view class="style-row">
      <view wx:for="{{styleList}}" wx:key="id"
        class="style-chip {{styleKey === item.id ? 'on' : ''}}"
        bindtap="onPickStyle" data-key="{{item.id}}">{{item.name}}</view>
    </view>
    <view class="bg-hint">风格决定字体族（衬线/黑体/圆体/楷体）、字号、字距、对齐与装饰符号。全部使用系统字体，无需下载、不会闪烁。</view>
  </view>

  <view class="block">
    <view class="block-title">背景图（内置 60 张，零网络）</view>
    <view class="bg-row">
      <view class="bg-ops">
        <view class="bg-op" bindtap="onPickAlbumBg">🖼️ 从相册选</view>
        <view wx:if="{{bgPhotoId || localBg}}" class="bg-op" bindtap="onClearPhoto">✕ 取消背景</view>
      </view>
      <view wx:if="{{bgPhotoId}}" class="bg-mode" bindtap="onShufflePhoto">🎲 换一张</view>
    </view>
    <scroll-view wx:if="{{!localBg}}" class="bg-scroll" scroll-x="true" show-scrollbar="{{false}}">
      <view wx:for="{{builtinPhotos}}" wx:key="id"
        class="bg-item {{bgSource === 'builtin' && bgPhotoId === item.id ? 'on' : ''}}"
        bindtap="onPickBuiltinBg" data-id="{{item.id}}"
        aria-label="选用内置背景图，摄影者 {{item.author}}">
        <image class="bg-thumb" src="{{item.url}}" mode="aspectFill"
          aria-hidden="true" />
      </view>
    </scroll-view>
    <view wx:if="{{localBg}}" class="bg-picked">已用相册图 ✓（你选的那张）</view>
    <view wx:if="{{bgPhotoId}}" class="bg-mode" bindtap="onCyclePhotoMode">
      处理方式：{{photoModeLabel}} ▸ 点击切换
    </view>
    <view wx:if="{{bgPhotoId}}" class="bg-credit">背景：{{bgAuthor}} · 来源 picsum（Unsplash）</view>
    <view class="loc-hint">内置 60 张已随包压缩好，不走网络、不需要服务器域名白名单，永远可用。默认灰度衬底，文字更易读。</view>
  </view>

  <view class="block">
    <view class="block-title">更多背景（网络图库 · 增强项）</view>
    <scroll-view wx:if="{{!localBg}}" class="bg-scroll" scroll-x="true" show-scrollbar="{{false}}">
      <view wx:for="{{photos}}" wx:key="id"
        class="bg-item {{bgSource === 'lib' && bgPhotoId === item.id ? 'on' : ''}}"
        bindtap="onPickPhoto" data-id="{{item.id}}"
        aria-label="选用网络背景图，摄影者 {{item.author}}">
        <image class="bg-thumb" src="{{item.url}}" mode="aspectFill"
          aria-hidden="true" />
      </view>
    </scroll-view>
    <view wx:if="{{bgSource === 'lib'}}" class="bg-picked">正在用网络图库 ✓</view>
    <view class="loc-hint">网络图库是增强项：需在后台「开发管理 → 服务器域名 → downloadFile」填 picsum.photos 与 fastly.picsum.photos。未配置或加载失败会自动回退到内置图，不影响出卡。</view>
  </view>

  <view class="theme-row">
    <view wx:for="{{themes}}" wx:key="id"
      class="theme-chip {{theme === item.id ? 'on' : ''}}"
      bindtap="onPickTheme" data-id="{{item.id}}"><view class="dot" style="background:{{item.color}}" aria-hidden="true"></view>{{item.name}}</view>
  </view>

  <view class="canvas-wrap">
    <canvas type="2d" id="solarCanvas" class="canvas" style="height:{{canvasH}}px"></canvas>
    <view wx:if="{{!rendered}}" class="canvas-ph">点「生成今日卡」或任一条目，预览显示在这里</view>
    <button wx:if="{{rendered}}" class="btn primary save save-btn {{savedKey ? 'saved-' + savedKey : ''}}" bindtap="onSaveImage">{{savedKey ? '✓ 已存相册' : '保存到相册'}}</button>
  </view>

  <view class="err" wx:if="{{err}}">{{err}}</view>
  <view class="tip">文案来自小程序内置节气/节日库，仅保存在你手机本地，不上传服务器。</view>
</view>

<privacy-panel privacy-show="{{privacyShow}}" />
