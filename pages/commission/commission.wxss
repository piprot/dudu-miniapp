/* ── commission 页（2026-09-18 重设计：三步流程 · 暖色 + 紫韵）── */
.page {
  padding: 24rpx 24rpx 60rpx; min-height: 100vh; box-sizing: border-box;
  background: linear-gradient(180deg, #f3efe9 0%, #efe9f5 100%);
}

.hero { padding: 30rpx 8rpx 26rpx; }
.hero-title { font-size: 42rpx; font-weight: 800; color: #3a2f4d; }
.hero-sub { font-size: 26rpx; color: #8a8098; margin-top: 10rpx; line-height: 1.6; }

/* 已持券提示（积分兑换的 9 折券）：让用户知道券已经接上了，不是换完就没了 */
.coupon-bar {
  background: linear-gradient(135deg, #e8f5e9 0%, #d7efdb 100%);
  border: 2rpx solid #b7dfc0; border-radius: 16rpx;
  padding: 18rpx 20rpx; margin-bottom: 12rpx;
  font-size: 24rpx; color: #1b5e20; line-height: 1.7;
  word-break: break-word; overflow-wrap: anywhere;
}
/* 券后价明细（原价 / 微信仍付全款 / 履约退差 / 券后实付）：把"付多少"讲清楚 */
.coupon-sub {
  background: #fbfdfb; border: 2rpx dashed #b7dfc0; border-radius: 16rpx;
  padding: 14rpx 20rpx; margin-bottom: 22rpx;
  font-size: 22rpx; color: #2e7d32; line-height: 1.6;
  word-break: break-word; overflow-wrap: anywhere;
}
/* 档位选择 */
.tier-list { margin-bottom: 24rpx; }
.tier {
  display: flex; align-items: center; background: #fff; border: 3rpx solid #eee6f2;
  border-radius: 22rpx; padding: 26rpx; margin-bottom: 18rpx;
  transition: transform .15s ease, border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
}
.tier.sel { border-color: #7b5ea7; background: #f8f4fd; box-shadow: 0 6rpx 20rpx rgba(123, 94, 167, 0.15); }
.tier-check {
  flex: none; width: 44rpx; height: 44rpx; border-radius: 50%;
  border: 3rpx solid #d5cbe2; color: #fff; font-size: 26rpx; font-weight: 800;
  text-align: center; line-height: 40rpx; margin-right: 22rpx; background: #fff;
}
.tier.sel .tier-check { background: #7b5ea7; border-color: #7b5ea7; }
.tier-main { flex: 1; }
.tier-name { font-size: 30rpx; font-weight: 700; color: #3a2f4d; }
.tier-desc { font-size: 23rpx; color: #9a90a8; margin-top: 6rpx; line-height: 1.5; }
.tier-price { flex: none; font-size: 38rpx; font-weight: 800; color: #7b5ea7; margin-left: 16rpx; }

/* 支付按钮 */
.pay-btn {
  background: linear-gradient(135deg, #8b6cc1 0%, #6d4fa3 100%);
  color: #fff; font-size: 31rpx; font-weight: 700; border-radius: 999rpx; padding: 10rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(109, 79, 163, 0.35);
}
.pay-btn[disabled] { background: #d8d2c6; box-shadow: none; }
.pay-note { text-align: center; font-size: 22rpx; color: #a89bb5; margin-top: 14rpx; }

/* 通用卡片（邮箱 / 确认页） */
.card {
  background: #fff; border-radius: 24rpx; padding: 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(80, 60, 110, 0.1), inset 0 2rpx 0 rgba(255, 255, 255, 0.7);
}
.label { font-size: 26rpx; font-weight: 600; color: #4a3f5c; margin: 18rpx 0 12rpx; }
.email-input {
  height: 92rpx; background: #f7f4fb; border-radius: 16rpx; padding: 0 22rpx;
  font-size: 28rpx; color: #3a2f4d;
}
.email-err { color: #b03a2e; font-size: 24rpx; margin-top: 10rpx; }
.story-box {
  background: #f7f4fb; border-radius: 16rpx; padding: 20rpx;
  font-size: 26rpx; color: #4a4155; line-height: 1.7; max-height: 400rpx; overflow: hidden;
  white-space: pre-wrap; word-break: break-all;
}
/* 故事正文 / 补充说明（可编辑，2026-09-18 由只读改为必填可改） */
.story-input, .note-input {
  width: 100%; box-sizing: border-box; background: #f7f4fb; border-radius: 16rpx;
  padding: 20rpx 22rpx; font-size: 27rpx; color: #3a2f4d; line-height: 1.7;
  min-height: 220rpx;
}
.note-input { min-height: 130rpx; }
.story-err { color: #b03a2e; font-size: 24rpx; margin-top: 10rpx; }
.submit-btn {
  margin-top: 28rpx; background: linear-gradient(135deg, #ff9d42 0%, #f5793b 100%);
  color: #fff; font-size: 30rpx; font-weight: 700; border-radius: 999rpx; padding: 8rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(245, 121, 59, 0.35);
}

/* 确认页 */
.done-card { border: 2rpx solid #e4f0e8; }
.done-line { font-size: 27rpx; color: #4a4155; line-height: 1.8; margin-bottom: 10rpx; }
.done-line .hl { color: #2e7d32; font-weight: 700; }
/* 确认页：本单用券结论（券后实付 / 履约退差），与顶部持券提示呼应 */
.done-coupon {
  background: linear-gradient(135deg, #e8f5e9 0%, #d7efdb 100%);
  border: 2rpx solid #b7dfc0; border-radius: 16rpx;
  padding: 16rpx 20rpx; margin-bottom: 10rpx;
  font-size: 24rpx; color: #1b5e20; line-height: 1.7;
  word-break: break-word; overflow-wrap: anywhere;
}
.divider { height: 2rpx; background: #f0ecf5; margin: 24rpx 0; }
.contact-title { font-size: 26rpx; font-weight: 700; color: #4a3f5c; margin-bottom: 12rpx; }
.contact-line { font-size: 27rpx; color: #4a4155; line-height: 1.9; }
.copy-btn {
  margin-top: 22rpx; background: #f1e9f8; color: #6d4fa3;
  border-radius: 999rpx; font-size: 27rpx; padding: 4rpx 0;
}
.home-btn {
  margin-top: 14rpx; background: #fff; color: #8a8098;
  border: 2rpx solid #e5def0; border-radius: 999rpx; font-size: 27rpx; padding: 4rpx 0;
}

.err { margin-top: 24rpx; color: #b03a2e; font-size: 26rpx; line-height: 1.6; }

/* ── 交互升级（Apple 流体，2026-10-01）：错误抖动 / 复制翻转 / 错误文案滑入 ── */
.email-input, .story-input { transition: border-color .18s ease, box-shadow .18s ease; }
.email-input.shake-a, .story-input.shake-a { animation: cmShakeA .45s ease; }
.email-input.shake-b, .story-input.shake-b { animation: cmShakeB .45s ease; }
@keyframes cmShakeA {
  20% { transform: translateX(-5px); } 40% { transform: translateX(4px); }
  60% { transform: translateX(-3px); } 80% { transform: translateX(2px); }
}
@keyframes cmShakeB {
  20% { transform: translateX(-5px); } 40% { transform: translateX(4px); }
  60% { transform: translateX(-3px); } 80% { transform: translateX(2px); }
}
.email-err, .story-err, .err { animation: cmErrIn .25s ease-out; }
@keyframes cmErrIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
.copy-btn { transition: background .2s ease, color .2s ease, box-shadow .2s ease; }
.copy-btn.copied {
  background: #2f9e6b; color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(47, 158, 107, 0.3);
  animation: cmFlip .55s ease;
}
@keyframes cmFlip {
  0% { transform: rotateX(0); } 50% { transform: rotateX(90deg); } 100% { transform: rotateX(0); }
}
