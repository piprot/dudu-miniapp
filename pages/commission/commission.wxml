<view class="page">
  <!-- 步骤一：选档 -->
  <block wx:if="{{step === 'select'}}">
    <view class="hero">
      <view class="hero-title">定制画面感内容 🎨</view>
      <view class="hero-sub">你写的故事，我们做成完整画面感内容，{{deliveryHours}} 小时内人工交付</view>
    </view>

    <!-- 积分兑换的 9 折券在这里"接上"：下单时随订单提交，履约按券退差价 -->
    <view class="coupon-bar" wx:if="{{couponTip}}">{{couponTip}}</view>
    <view class="coupon-sub" wx:if="{{couponDetail}}">{{couponDetail}}</view>

    <view class="tier-list">
      <view
        wx:for="{{tiers}}"
        wx:key="productId"
        class="tier {{item.sel ? 'sel' : ''}}"
        data-id="{{item.productId}}"
        bindtap="onSelectTier">
        <view class="tier-check">{{item.sel ? '✓' : ''}}</view>
        <view class="tier-main">
          <view class="tier-name">{{item.name}}</view>
          <view class="tier-desc">{{item.desc}}</view>
        </view>
        <view class="tier-price">{{item.priceText}}</view>
      </view>
    </view>

    <button class="pay-btn" bindtap="onPay" loading="{{paying}}" disabled="{{paying}}">
      💳 付费定制（{{tiers[0].sel ? tiers[0].priceText : tiers[1].priceText}} 起）
    </button>
    <view class="pay-note">微信安全支付 · 完成 {{deliveryHours}} 小时内回邮到你填写的邮箱</view>
  </block>

  <!-- 步骤二：填邮箱（支付成功后） -->
  <block wx:if="{{step === 'email'}}">
    <view class="hero">
      <view class="hero-title">✅ 支付成功！</view>
      <view class="hero-sub">留下你的邮箱，完成后直接回邮给你</view>
    </view>

    <view class="card">
      <view class="label">接收邮箱</view>
      <input class="email-input" placeholder="name@example.com" value="{{email}}" bindinput="onInputEmail" />
      <view class="email-err" wx:if="{{emailErr}}">{{emailErr}}</view>

      <view class="label">你的故事（画师按此开工，请写好、可修改）</view>
      <textarea class="story-input" placeholder="写下你想做成画面感内容的故事正文；例如：人物、发生了什么、想表达什么……"
                value="{{story}}" bindinput="onInputStory" maxlength="{{storyMax}}" auto-height="true" />
      <view class="story-err" wx:if="{{storyErr}}">{{storyErr}}</view>

      <view class="label">补充说明（可选）</view>
      <textarea class="note-input" placeholder="画风偏好、篇幅、必须保留的细节、交付格式等（可留空）"
                value="{{note}}" bindinput="onInputNote" maxlength="{{noteMax}}" auto-height="true" />

      <button class="submit-btn" bindtap="onSubmitEmail" loading="{{submitting}}" disabled="{{submitting}}">📮 确认提交</button>
    </view>
  </block>

  <!-- 步骤三：确认页 -->
  <block wx:if="{{step === 'done'}}">
    <view class="hero">
      <view class="hero-title">🎉 下单成功！</view>
      <view class="hero-sub">我们已收到你的定制需求</view>
    </view>

    <view class="card done-card">
      <view class="done-line">⏱ 预计 <text class="hl">{{deliveryHours}} 小时内</text>完成，并回邮到你的邮箱</view>
      <view class="done-line">📧 收件邮箱：<text class="hl">{{email}}</text></view>
      <view class="done-line">📜 邮件内容默认为你写下故事原文，画师完成后再发送成品</view>
      <view class="done-coupon" wx:if="{{couponFinal}}">🎫 {{couponFinal}}</view>
      <view class="divider"></view>
      <view class="contact-title">如有问题，随时联系我们</view>
      <view class="contact-line">邮箱：{{contact.email}}</view>
      <view class="contact-line">微信：{{contact.wechat}}</view>
      <button class="copy-btn" bindtap="onCopyContact">复制联系方式</button>
      <button class="home-btn" bindtap="onBackHome">返回首页</button>
    </view>
  </block>

  <view class="err" wx:if="{{err}}">{{err}}</view>
</view>
