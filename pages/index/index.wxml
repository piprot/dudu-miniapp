<view class="page">
  <!-- 顶部：品牌（轻量，让位给创作入口） -->
  <view class="hero">
    <view class="hero-title">dudu 画面感</view>
    <view class="hero-author">把你的故事，变成打动人的文字与画面感内容</view>
    <button class="hero-share" open-type="share">分享给朋友 ›</button>
  </view>

  <!-- 积分 / 每日签到（进入小程序自动领取，每天一次） -->
  <view class="points-bar" bindtap="goPoints">
    <view class="points-left">
      <text class="points-num">💰 {{points}}</text>
      <text class="points-label">积分</text>
    </view>
    <view class="points-right">
      <text wx:if="{{dailyChecked}}" class="daily-tag done">✓ 今日已签到 · 连续 {{streak}} 天</text>
      <text wx:else class="daily-tag todo">每日登录送积分 ›</text>
    </view>
  </view>

  <!-- 创作工具：纯本地，无 AI（长按工具卡可拖动排序，顺序自动记住） -->
  <view class="tool-section"
    catchtouchmove="{{dragIdx > -1 ? 'onToolDragMove' : ''}}"
    catchtouchend="{{dragIdx > -1 ? 'onToolDragEnd' : ''}}"
    catchtouchcancel="{{dragIdx > -1 ? 'onToolDragEnd' : ''}}">
    <view wx:for="{{tools}}" wx:key="key"
      class="tool-card {{item.cls}} {{dragIdx === index ? 'dragging' : ''}}"
      style="{{dragIdx === index ? 'transform:translateY(' + dragDy + 'px);' : (offsets[index] ? 'transform:translateY(' + offsets[index] + 'px);' : '')}}"
      bindtap="onTapTool" data-key="{{item.key}}"
      bindlongpress="onToolDragStart" data-idx="{{index}}">
      <view class="tool-title">{{item.title}}</view>
      <view class="tool-desc">{{item.desc}}</view>
    </view>
    <view class="tool-hint-drag">长按工具卡可拖动排序 · 顺序自动记住</view>
  </view>
</view>
