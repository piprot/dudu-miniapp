.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 28rpx 30rpx 64rpx;
  box-sizing: border-box;
}
.hd { padding-bottom: 18rpx; margin-bottom: 22rpx; border-bottom: 3rpx solid var(--primary); }
.hd-title { font-size: 40rpx; font-weight: 700; color: var(--ink); letter-spacing: 1rpx; }
.hd-sub { font-size: 24rpx; color: var(--text-sub); margin-top: 10rpx; line-height: 1.5; }

.search { margin-bottom: 18rpx; }
.input, .ta {
  width: 100%; box-sizing: border-box; background: var(--bg-card);
  border: 1rpx solid var(--border); border-radius: 14rpx; padding: 18rpx 20rpx;
  font-size: 27rpx; line-height: 1.6; color: var(--ink);
}
.ta { min-height: 150rpx; }

/* 旧 .tags / .cats（一次性平铺标签云与大类）已删——
   改用 app.wxss 的 .picker 分层选择器（常用→大类→小类）。
   平铺是用户明确点过的问题：标签随收藏无限增长，铺满整屏且没有起点。 */

/* 今日推荐：金色渐变突出「天天换」的入口 */
.today {
  background: linear-gradient(135deg, var(--bg-surface-1) 0%, var(--bg-surface-2) 100%);
  border: 1rpx solid var(--bg-surface-2); border-radius: var(--r-md);
  padding: 22rpx; margin-bottom: 18rpx;
}
.today-hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.today-label { font-size: 25rpx; font-weight: 700; color: #8a6a2f; letter-spacing: 1rpx; }
.today-text { font-size: 28rpx; color: var(--ink); line-height: 1.7; }
.mini.gold { background: #8a6a2f; color: #fff; border-color: #8a6a2f; padding: 10rpx 22rpx; font-size: 23rpx; }

/* 旧 .cats（6 大类平铺）已删——改用 app.wxss 的 .picker 分层选择器（常用→大类→小类）。*/

.stat { font-size: 23rpx; color: var(--text-tertiary); margin-bottom: 16rpx; }

.list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 22rpx; }
.qcard {
  background: var(--bg-card); border: 1rpx solid var(--border-soft);
  border-radius: var(--r-md); padding: 22rpx;
}
.qtext { font-size: 28rpx; color: var(--ink); line-height: 1.7; }
.qmeta { margin-top: 12rpx; display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.qtag { font-size: 22rpx; color: var(--primary-deep); background: var(--bg-surface-1); border: 1rpx solid var(--bg-surface-2); border-radius: var(--r-pill); padding: 4rpx 14rpx; }
.qsrc { font-size: 22rpx; color: var(--text-tertiary); }
.qacts { display: flex; gap: 14rpx; margin-top: 16rpx; }
.mini {
  font-size: 25rpx; color: var(--primary-deep); background: var(--bg-surface-1);
  border: 1rpx solid var(--border); border-radius: 12rpx; padding: 12rpx 26rpx;
}
.mini.danger { color: var(--danger); background: #fdeaea; border-color: #f3d2d2; }
.empty { font-size: 25rpx; color: var(--text-tertiary); text-align: center; padding: 40rpx 0; }

.btn { font-size: 28rpx; color: var(--text-body); background: var(--bg-surface-4); border-radius: 14rpx; padding: 18rpx 0; line-height: 1.4; margin: 0; }
.btn.ghost { flex: none; padding: 14rpx 30rpx; font-size: 26rpx; background: var(--bg-surface-1); color: var(--primary-deep); border: 1rpx solid var(--border); }
.btn.primary { background: var(--primary); color: #fff; font-weight: 600; }
.btn.add { width: 100%; margin-bottom: 18rpx; }

.theme-row { display: flex; flex-wrap: wrap; gap: 14rpx; margin: 18rpx 0 6rpx; }
.theme-chip {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 24rpx; color: #6b5636; background: var(--bg-surface-1);
  border: 2rpx solid var(--bg-surface-5); border-radius: 24rpx; padding: 10rpx 22rpx;
}
.theme-chip .dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.theme-chip.on { background: var(--primary); color: #fff; border-color: var(--primary); }
.theme-chip.on .dot { box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.65); }

.canvas-wrap { margin-top: 22rpx; background: var(--bg-card); border: 1rpx solid var(--border-soft); border-radius: 20rpx; padding: 16rpx; }
.canvas { width: 100%; background: var(--bg-page); border-radius: 14rpx; display: block; }
.canvas-ph { font-size: 24rpx; color: #b3a890; text-align: center; padding: 48rpx 0; }
.btn.save { flex: none; margin-top: 22rpx; padding: 18rpx 64rpx; }
.err { margin-top: 16rpx; font-size: 24rpx; color: var(--danger); line-height: 1.6; }
.tip { margin-top: 22rpx; font-size: 22rpx; color: var(--text-tertiary); line-height: 1.6; text-align: center; }

.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,0.45); display: flex; align-items: flex-end; z-index: 50; }
.sheet { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx 30rpx 48rpx; box-sizing: border-box; }
.sheet-title { font-size: 32rpx; font-weight: 700; color: var(--ink); margin-bottom: 22rpx; }
.field { margin-bottom: 20rpx; }
.label { font-size: 25rpx; font-weight: 600; color: var(--text-title); margin-bottom: 10rpx; }
.sheet-acts { display: flex; gap: 20rpx; margin-top: 12rpx; }
.sheet-acts .btn { flex: 1; }

/* ── 来源类型（2026-10-06 与台词/书摘卡合并后新增）────────────────────
   层级：来源徽标比标签更「重」（实心底），因为它是互斥枚举、是筛选的主维度；
   标签是自由标签、粒度更细，故用浅底避免抢戏。 */
.kind-filter { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0 4rpx; }
.kind-chip { font-size: 23rpx; color: var(--text-body); background: var(--bg-card); border: 1rpx solid var(--border); border-radius: var(--r-pill); padding: 8rpx 22rpx; }
.kind-chip.on { background: var(--primary); color: #fff; border-color: var(--primary); font-weight: 600; }

.kind-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.qkind { font-size: 22rpx; color: #fff; background: var(--accent-blue); border-radius: var(--r-pill); padding: 4rpx 16rpx; }
