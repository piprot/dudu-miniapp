<view class="page">
  <view class="hd">
    <view class="hd-title">📚 金句收藏馆</view>
    <view class="hd-sub">本地语料库 · 标签分类 · 搜索 · 一键成卡（纯本地，零 AI）</view>
  </view>

  <view class="search">
    <input class="input" value="{{keyword}}" bindinput="onSearch" placeholder="搜索金句 / 出处 / 标签" />
  </view>

  <!-- 今日推荐：按日期稳定轮换，同一天不变、跨天必变（运营「天天换」诉求） -->
  <view class="today" wx:if="{{todayPick}}">
    <view class="today-hd">
      <view class="today-label">✨ 今日推荐</view>
      <view class="mini gold" bindtap="onMakeTodayCard">🖼️ 成卡</view>
    </view>
    <view class="today-text">{{todayPick.text}}</view>
  </view>

  <view class="cats">
    <view wx:for="{{cats}}" wx:key="key"
      class="cat {{activeCat === item.key ? 'on' : ''}}"
      bindtap="onPickCat" data-cat="{{item.key}}">{{item.name}}</view>
  </view>

  <view class="tags" wx:if="{{tags.length}}">
    <view wx:for="{{tags}}" wx:key="tag"
      class="tag {{activeTag === item.tag ? 'on' : ''}}"
      bindtap="onPickTag" data-tag="{{item.tag}}">#{{item.tag}} ({{item.count}})</view>
    <view wx:if="{{activeTag}}" class="tag clear" bindtap="onPickTag" data-tag="{{activeTag}}">清除筛选</view>
  </view>

  <view class="stat">已收藏 {{count}} 条</view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="id" class="qcard">
      <view class="qtext" bindtap="onEdit" data-id="{{item.id}}">{{item.text}}</view>
      <view class="qmeta" wx:if="{{item.tags.length || item.source}}">
        <text wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" class="qtag">#{{t}}</text>
        <text wx:if="{{item.source}}" class="qsrc">—— {{item.source}}</text>
      </view>
      <view class="qacts">
        <view class="mini" bindtap="onMakeCard" data-id="{{item.id}}">🖼️ 成卡</view>
        <view class="mini" bindtap="onCopy" data-text="{{item.text}}">📋 复制</view>
        <view class="mini danger" bindtap="onDelete" data-id="{{item.id}}">🗑️ 删</view>
      </view>
    </view>
    <view wx:if="{{!list.length}}" class="empty">还没有收藏，点下方「＋ 收藏金句」开始吧</view>
  </view>

  <button class="btn primary add" bindtap="onAdd">＋ 收藏金句</button>

  <view class="block">
    <view class="block-title">排版风格</view>
    <view class="style-row">
      <view wx:for="{{styleList}}" wx:key="id"
        class="style-chip {{styleKey === item.id ? 'on' : ''}}"
        bindtap="onPickStyle" data-key="{{item.id}}">{{item.name}}</view>
    </view>
    <view class="bg-hint">风格决定字体族（衬线/黑体/圆体/楷体）、字号、字距、对齐与装饰符号。全部使用系统字体，无需下载、不会闪烁。</view>
  </view>

  <view class="block">
    <view class="block-title">背景图（内置 16 张，零网络）</view>
    <view class="bg-row">
      <view class="bg-ops">
        <view class="bg-op" bindtap="onPickAlbumBg">🖼️ 从相册选</view>
        <view wx:if="{{bgPhotoId || localBg}}" class="bg-op" bindtap="onClearPhoto">✕ 取消背景</view>
      </view>
      <view wx:if="{{bgPhotoId}}" class="bg-mode" bindtap="onShufflePhoto">🎲 换一张</view>
    </view>
    <scroll-view wx:if="{{!localBg}}" class="bg-scroll" scroll-x="true" show-scrollbar="{{false}}">
      <view wx:for="{{builtinPhotos}}" wx:key="id"
        class="bg-item {{bgSource === 'builtin' && bgPhotoId === item.id ? 'on' : ''}}"
        bindtap="onPickBuiltinBg" data-id="{{item.id}}">
        <image class="bg-thumb" src="{{item.url}}" mode="aspectFill" />
      </view>
    </scroll-view>
    <view wx:if="{{localBg}}" class="bg-picked">已用相册图 ✓（你选的那张）</view>
    <view wx:if="{{bgPhotoId}}" class="bg-mode" bindtap="onCyclePhotoMode">
      处理方式：{{photoModeLabel}} ▸ 点击切换
    </view>
    <view wx:if="{{bgPhotoId}}" class="bg-credit">背景：{{bgAuthor}} · 来源 picsum（Unsplash）</view>
    <view class="loc-hint">内置图已随包压缩好，不走网络、不需要服务器域名白名单，永远可用。默认灰度衬底，文字更易读。</view>
  </view>

  <view class="block">
    <view class="block-title">更多背景（网络图库 · 增强项）</view>
    <scroll-view wx:if="{{!localBg}}" class="bg-scroll" scroll-x="true" show-scrollbar="{{false}}">
      <view wx:for="{{photos}}" wx:key="id"
        class="bg-item {{bgSource === 'lib' && bgPhotoId === item.id ? 'on' : ''}}"
        bindtap="onPickPhoto" data-id="{{item.id}}">
        <image class="bg-thumb" src="{{item.url}}" mode="aspectFill" />
      </view>
    </scroll-view>
    <view wx:if="{{bgSource === 'lib'}}" class="bg-picked">正在用网络图库 ✓</view>
    <view class="loc-hint">网络图库是增强项：需在后台「开发管理 → 服务器域名 → downloadFile」填 picsum.photos 与 fastly.picsum.photos。未配置或加载失败会自动回退到内置图，不影响出卡。</view>
  </view>

  <!-- 主题选择（6 套数据化主题，渲染引擎自动读取配色） -->
  <view class="theme-row">
    <view wx:for="{{themes}}" wx:key="id"
      class="theme-chip {{theme === item.id ? 'on' : ''}}"
      bindtap="onPickTheme" data-id="{{item.id}}"><view class="dot" style="background:{{item.color}}"></view>{{item.name}}</view>
  </view>

  <view class="canvas-wrap">
    <canvas type="2d" id="quotesCanvas" class="canvas" style="height:{{canvasH}}px"></canvas>
    <view wx:if="{{!rendered}}" class="canvas-ph">点某条金句的「🖼️ 成卡」，预览显示在这里</view>
    <button wx:if="{{rendered}}" class="btn primary save save-btn {{savedKey ? 'saved-' + savedKey : ''}}" bindtap="onSaveImage">{{savedKey ? '✓ 已存相册' : '保存到相册'}}</button>
  </view>

  <view class="err" wx:if="{{err}}">{{err}}</view>
  <view class="tip">收藏与卡片均保存在你手机本地，不会上传任何服务器。</view>
</view>

<!-- 编辑弹层 -->
<view wx:if="{{showEditor}}" class="mask" catchtouchmove="noop">
  <view class="sheet">
    <view class="sheet-title">{{edit.id ? '编辑金句' : '收藏金句'}}</view>
    <view class="field">
      <view class="label">金句内容</view>
      <textarea class="ta" value="{{edit.text}}" bindinput="onField" data-field="text" placeholder="写一句打动你的话" maxlength="-1" />
    </view>
    <view class="field">
      <view class="label">出处（可选）</view>
      <input class="input" value="{{edit.source}}" bindinput="onField" data-field="source" placeholder="如：出自《xxx》/ 谁说的" />
    </view>
    <view class="field">
      <view class="label">标签（逗号分隔，可选）</view>
      <input class="input" value="{{edit.tags}}" bindinput="onField" data-field="tags" placeholder="如：成长, 生活" />
    </view>
    <view class="sheet-acts">
      <button class="btn ghost" bindtap="onCloseEditor">取消</button>
      <button class="btn primary" bindtap="onSaveEdit">保存</button>
    </view>
  </view>
</view>

<privacy-panel privacy-show="{{privacyShow}}" />
